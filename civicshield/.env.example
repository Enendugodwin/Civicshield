# CivicShield AI provider (Meta Muse Spark)
# Copy to .env for local use: cp .env.example .env
#CIVICSHIELD_AI_PROVIDER=mock
# Set provider to muse_spark and add a key to go live:
CIVICSHIELD_AI_PROVIDER=muse_spark
META_API_KEY=
META_API_BASE_URL=https://api.meta.com/v1
META_MODEL_ID=muse-spark
AI_TIMEOUT_SECONDS=15.0
AI_MAX_RETRIES=3
